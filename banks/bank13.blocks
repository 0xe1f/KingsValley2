aebf_tbl:  start 0xAEBF end 0xAF37 type worddata
af37_tbl:  start 0xAF37 end 0xAFAF type worddata
afb1_tbl:  start 0xAFB1 end 0xB029 type worddata
b7cd_tbl:  start 0xB7CD end 0xB847 type worddata
b9ad_tbl:  start 0xB9AD end 0xB9CF type worddata
ba57_tbl:  start 0xBA57 end 0xBA61 type worddata
bb38_tbl:  start 0xBB38 end 0xBB3C type worddata
